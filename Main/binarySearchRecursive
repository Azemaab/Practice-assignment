public static int binarySearchRecursive(int[] a, int target, int low, int high) {
   
    if (low > high) {
        return -1;
    }

    int mid = low + (high - low) / 2;

    
    if (a[mid] == target) {
        return mid;
    }

    
    if (target < a[mid]) {
        return binarySearchRecursive(a, target, low, mid - 1);
    }
    return binarySearchRecursive(a, target, mid + 1, high);
}
